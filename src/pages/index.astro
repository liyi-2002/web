---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import neauLogo from '../assets/neau-logo.png';
import zjuLogo from '../assets/zju-logo.png';
import githubLogo from '../assets/github.png';
import renImg from '../assets/ren.jpg';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="profile">
				<Image class="avatar" src={renImg} width={440} loading="eager" alt="李毅的个人照片" />
				<div class="profile-info">
					<section class="education">
						<h2>My Educational Background:</h2>
						<ul>
							<li>
								<img class="logo" src={neauLogo.src} alt="Northeast Agricultural University" width="96" height="96" />
								<div class="info">
									<p class="school">Northeast Agricultural University (CHINA)</p>
									<p class="detail">B.S. in Smart Agriculture · 2021 – 2025</p>
								</div>
							</li>
							<li>
								<img class="logo" src={zjuLogo.src} alt="Zhejiang University" width="96" height="96" />
								<div class="info">
									<p class="school">Zhejiang University (CHINA)</p>
									<p class="detail">M.S. in Agronomy &amp; Seed Industry · 2025 – 2028</p>
								</div>
							</li>
						</ul>
					</section>
					<section class="education">
						<h2>My GitHub: <a href="https://github.com/liyi-2002" target="_blank" rel="noopener"><img class="github-logo" src={githubLogo.src} alt="GitHub" /></a></h2>
					</section>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	body main {
		flex: 1;
		margin: 0 auto 0 max(1.5em, 5vw);
	}
	.profile {
		display: flex;
		align-items: flex-start;
		gap: 5rem;
		margin-top: 0.8rem;
	}
	.profile .avatar {
		width: 220px;
		height: auto;
		border-radius: 12px;
		flex-shrink: 0;
	}
	.profile-info {
		flex: 1;
		min-width: 0;
	}
	@media (max-width: 720px) {
		.profile {
			flex-direction: column;
			align-items: center;
		}
		.profile .avatar {
			width: 180px;
		}
	}
	.education {
		margin-top: 1.5rem;
		text-align: left;
	}
	.education h2 {
		font-size: 1.25rem;
		font-weight: 600;
		margin-bottom: 1.2rem;
		margin-left: -20px;
	}
	.education ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin-left: -22px;
	}
	.education li {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.education .logo {
		width: 72px;
		height: 72px;
		object-fit: contain;
		flex-shrink: 0;
	}
	.education .github-logo {
		height: 52px;
		width: auto;
		vertical-align: middle;
		object-fit: contain;
	}
	.education .info p {
		margin: 0;
	}
	.education .school {
		font-weight: 700;
		color: rgb(var(--black));
	}
	.education .detail {
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}
</style>
