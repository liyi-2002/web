---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import evo2Figure from '../../assets/evo2-figure.png';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1800px, 90%);
				margin: 0 auto 0 max(1.5em, 7vw);
			}
			.modules {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.content-grid {
				display: flex;
				gap: 2.5rem;
				align-items: stretch;
			}
			.content-grid .modules {
				flex: 1.1;
				min-width: 0;
			}
			.side-module {
				flex: 0.9;
				display: flex;
				flex-direction: column;
			}
			.side-module .module-box {
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.side-module .module-scroll {
				flex: 1;
				height: auto;
			}
			.side-module h2 {
				font-size: 1.5rem;
				font-weight: 600;
				margin: 0 0 0.6em 0;
				color: rgb(var(--black));
			}
			.module h2 {
				font-size: 1.5rem;
				font-weight: 600;
				margin: 0 0 0.6em 0;
				color: rgb(var(--black));
			}
			.module-box {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1em 1.25em;
				background: #fff;
				box-shadow: 0 1px 6px rgba(var(--gray), 10%);
			}
			.module-scroll {
				height: 300px;
				overflow-y: auto;
				padding-right: 0.5em;
			}
			.module-scroll p {
				margin: 0 0 0.75em 0;
			}
			.module-scroll a {
				color: var(--accent);
				text-decoration: none;
			}
			.module-scroll a:hover {
				text-decoration: underline;
			}
			.paper {
				display: flex;
				align-items: center;
				gap: 1.25rem;
				padding: 0.6em 0.25em;
			}
			.module-scroll > * {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.75em;
			}
			.paper-title {
				margin: 0;
				flex: 1;
			}
			.paper-title a {
				color: rgb(var(--black));
				font-weight: 700;
				font-size: 1.2rem;
				text-decoration: none;
			}
			.paper-title a:hover {
				color: var(--accent);
				text-decoration: underline;
			}
			.paper-thumb {
				flex-shrink: 0;
			}
			.paper-img {
				width: 120px;
				height: 72px;
				object-fit: cover;
				border-radius: 6px;
				display: block;
			}
			@media (max-width: 720px) {
				.paper {
					flex-wrap: wrap;
				}
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 2rem 0 0 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				.content-grid {
					flex-direction: column;
				}
				.side-module {
					flex: none;
					width: 100%;
				}
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="content-grid">
			<section class="modules">
				<div class="module">
					<h2>Valuable Research Advances</h2>
					<div class="module-box">
						<div class="module-scroll">
							<div class="paper">
								<p class="paper-title">
									<a href="https://www.nature.com/articles/s41586-026-10176-5" target="_blank" rel="noopener">(2026-10-31) EVO2：全生命域生成式基因组大模型 | <strong><em>Nature</em></strong> | 20260304</a>
								</p>
								<a class="paper-thumb" href="https://www.nature.com/articles/s41586-026-10176-5" target="_blank" rel="noopener">
									<Image class="paper-img" src={evo2Figure} width={240} alt="EVO2 论文图 1" />
								</a>
							</div>
						</div>
					</div>
				</div>
				<div class="module">
					<h2>Interesting Ideas &amp; Knowledge</h2>
					<div class="module-box">
						<div class="module-scroll">
							<p>Photography, writing, tools, and small projects I enjoy.</p>
						</div>
					</div>
				</div>
				<div class="module">
					<h2>Other Shares</h2>
					<div class="module-box">
						<div class="module-scroll">
							<p>Other things I'd like to share with you.</p>
						</div>
					</div>
				</div>
			</section>
			<aside class="side-module">
				<h2>My Works</h2>
				<div class="module-box">
					<div class="module-scroll">
						<p>My work content will be shared here.</p>
					</div>
				</div>
			</aside>
			</div>
			<section>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/content/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
