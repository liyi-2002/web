<folio-calendar class="card-calendar" data-calendar role="region" aria-label="日历">
	<div class="card-calendar__header">
		<time class="card-calendar__month" data-calendar-month aria-live="polite" aria-atomic="true">日历</time>
		<div class="card-calendar__controls" role="group" aria-label="切换月份">
			<button type="button" data-calendar-prev aria-label="上个月">上月</button>
			<button type="button" data-calendar-today aria-label="回到今天">今天</button>
			<button type="button" data-calendar-next aria-label="下个月">下月</button>
		</div>
	</div>
	<div class="card-calendar__body">
		<table aria-label="月历">
			<thead><tr>{['一', '二', '三', '四', '五', '六', '日'].map(day => <th scope="col"><abbr title={'星期' + day}>{day}</abbr></th>)}</tr></thead>
			<tbody></tbody>
		</table>
	</div>
	<noscript><p class="card-calendar__fallback">启用 JavaScript 后显示月历。</p></noscript>
</folio-calendar>

<script>
	import '../scripts/calendar';
</script>

<style>
	.card-calendar {
		position: absolute; inset: 1.9rem .65rem .5rem; z-index: 1;
		display: flex; flex-direction: column; gap: .2rem;
		color: #f4f3ee; text-shadow: 0 1px 5px #000; cursor: auto; touch-action: pan-y;
		font-family: var(--site-font); line-height: 1; user-select: none;
	}
	.card-calendar__header { display: flex; align-items: center; justify-content: space-between; gap: .3rem; min-height: 1.6rem; flex: none; }
	.card-calendar__month { white-space: nowrap; font: 400 clamp(1rem, 2.6cqw, 1.2rem)/1 'Times New Roman', Times, serif; }
	.card-calendar__controls { display: flex; gap: .1rem; }
	.card-calendar button {
		appearance: none; border: 1px solid transparent; border-radius: .25rem; padding: .2rem .15rem;
		min-height: 1.6rem; background: transparent; color: #dfdfd9; font: inherit; font-size: .875rem; line-height: 1;
		cursor: pointer; text-shadow: inherit; white-space: nowrap;
	}
	.card-calendar button:hover { color: #fff; background: #ffffff0d; border-color: #ffffff26; }
	.card-calendar button:focus-visible { outline: 1px solid #fff; outline-offset: 1px; }
	.card-calendar__body { flex: 1; min-height: 0; border-top: 1px solid #ffffff1a; }
	.card-calendar table { width: 100%; height: 100%; table-layout: fixed; border-collapse: collapse; font-size: .875rem; }
	.card-calendar th { height: 1.1rem; font-weight: 400; color: #d5d6d4; }
	.card-calendar abbr { text-decoration: none; }
	/* Calendar dates are created in the browser, so their styles are not Astro-scoped. */
	.card-calendar :global(td), .card-calendar th { padding: 0; border: 0; text-align: center; vertical-align: middle; line-height: 1; }
	.card-calendar :global(td time) {
		display: inline-flex; align-items: center; justify-content: center;
		width: 1.35rem; min-height: 1rem; border: 1px solid transparent; border-radius: .3rem;
		font: 400 .875rem/1 'Times New Roman', Times, serif; font-variant-numeric: tabular-nums;
	}
	.card-calendar :global(td:nth-child(n + 6)), .card-calendar th:nth-child(n + 6) { color: #e5d7b8; }
	.card-calendar :global(td[data-outside]) { color: #ffffff52; }
	.card-calendar :global(time[aria-current="date"]) { color: #fff8e6; border-color: #e6d6ad94; background: #e8d7ad1a; text-shadow: 0 1px 4px #000; }
	.card-calendar__fallback { margin: .5rem 0; font-size: .875rem; line-height: 1.4; }
</style>
