<div class="particle-background" aria-hidden="true">
	<canvas data-particle-swarm></canvas>
</div>

<script>
	import { mountParticleSwarm } from '../scripts/particle-swarm';
	const canvas = document.querySelector<HTMLCanvasElement>('[data-particle-swarm]');
	if (canvas) {
		const dispose = mountParticleSwarm(canvas);
		document.addEventListener('astro:before-swap', dispose, { once: true });
		if (import.meta.hot) import.meta.hot.dispose(dispose);
	}
</script>

<style>
	.particle-background {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>
