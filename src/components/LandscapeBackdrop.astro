---
import PhotographicBackdrop from './PhotographicBackdrop';
---

<div class="landscape-background" aria-hidden="true">
	<picture class="valley-poster">
		<source media="(max-width: 720px)" srcset="/landscape/wellington-stars-mobile.webp" />
		<img src="/landscape/wellington-stars.webp" alt="" width="3200" height="2133" fetchpriority="high" decoding="async" />
	</picture>
	<PhotographicBackdrop client:load />
	<div class="valley-shade"></div>
</div>

<style is:global>
	.landscape-background {
		position: fixed;
		inset: 0;
		z-index: -2;
		overflow: hidden;
		pointer-events: none;
		background: #15191f;
	}
	.valley-poster, .valley-canvas, .valley-shade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.valley-poster, .valley-canvas { filter: saturate(.66) brightness(.79); }
	.valley-poster img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.035); }
	.valley-canvas { display: block; opacity: 0; transition: opacity 1.4s ease; }
	.valley-canvas[data-scene="ready"] { opacity: 1; }
	.valley-shade {
		background:
			linear-gradient(90deg, #0b101c99 0%, #10131b30 26%, transparent 53%),
			linear-gradient(0deg, #080d1494, transparent 27%, transparent 80%, #090c1326);
	}
	@media (max-width: 720px) {
		.valley-shade { background: linear-gradient(#0b101b59, transparent 25%, transparent 51%, #090e19bd 80%); }
	}
</style>
