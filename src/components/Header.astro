---
import HeaderLink from './HeaderLink.astro';
import { SITE_SECTIONS } from '../consts';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={['site-header', { compact }]}>
	<div class="header-inner">
		<a class="wordmark" href="/" lang="en">welcome！</a>
		{!compact && <nav class="nav-links" aria-label="主导航">
			{SITE_SECTIONS.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
		</nav>}
		{!compact && <a class="contact-link" href="/#contact">联系我</a>}
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 2;
	}
	.header-inner {
		width: min(var(--folio-max), calc(100% - 2 * var(--folio-gutter)));
		margin-inline: auto;
		min-height: var(--header-height);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		border-bottom: 1px solid var(--rule);
	}
	.compact .header-inner { grid-template-columns: 1fr; border-bottom: 0; }
	.wordmark {
		width: fit-content;
		font: italic 400 clamp(1.375rem, 2vw, 1.75rem)/1 var(--font-serif);
		text-decoration: none;
		white-space: nowrap;
	}
	.wordmark:hover { color: var(--accent); }
	.nav-links { display: flex; align-items: center; gap: clamp(.2rem, 2vw, 1.2rem); }
	.contact-link {
		justify-self: end;
		padding-block: .55rem;
		color: var(--ink);
		text-decoration-color: var(--rule);
		text-underline-offset: .35em;
		font-size: 1rem;
		white-space: nowrap;
	}
	.contact-link:hover { text-decoration-color: var(--accent); color: var(--accent); }

	@media (max-width: 560px) {
		.site-header:not(.compact) .header-inner { grid-template-columns: 1fr auto; }
		.nav-links { grid-column: 1 / -1; grid-row: 2; gap: .7rem; }
	}
</style>
