---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/content">内容</HeaderLink>
			<HeaderLink href="/about">其他</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #f5f6f8;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		display: inline-block;
		padding: 1em 0.5em;
		color: var(--black);
		text-decoration: none;
		transition: transform 0.2s ease, color 0.2s ease;
	}
	nav a:hover {
		transform: translateY(-3px);
		color: var(--accent);
	}
</style>
