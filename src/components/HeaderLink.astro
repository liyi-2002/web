---
interface Props {
	href: string;
	descendantsOf?: string | false;
}

const { href, descendantsOf = href } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const destination = href.replace(/\/$/, '') || '/';
const section = descendantsOf === false ? '' : descendantsOf.replace(/\/$/, '');
const isCurrentPage = pathname === destination;
const isActive = isCurrentPage || (section !== '' && pathname.startsWith(section + '/'));
---

<a href={href} class:list={{ active: isActive }} aria-current={isCurrentPage ? 'page' : isActive ? 'location' : undefined}>
	<slot />
</a>

<style>
	a {
		position: relative;
		display: block;
		padding: .62rem .7rem;
		color: var(--muted);
		font-size: .9375rem;
		text-decoration: none;
		white-space: nowrap;
	}
	a:hover, a.active { color: var(--text); }
	a.active::after {
		content: '';
		position: absolute;
		inset: auto .7rem .25rem;
		height: 2px;
		border-radius: 1rem;
		background: var(--accent);
	}

	@media (max-width: 480px) {
		a { padding-inline: .4rem; font-size: .875rem; }
		a.active::after { inset-inline: .4rem; }
	}
</style>
