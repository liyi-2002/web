---
interface Props {
	tone?: 'silver' | 'champagne';
}

const { tone = 'silver' } = Astro.props;
---

<span class="paper-pin" data-tone={tone} aria-hidden="true">
	<span class="paper-pin__imprint"></span>
	<span class="paper-pin__shaft"></span>
	<span class="paper-pin__head"></span>
</span>

<style>
	.paper-pin {
		--pin-size: clamp(16px, 1.7cqw, 20px);
		--pin-light: #f5f7f8;
		--pin-glow: #ffffffd6;
		--pin-mid: #b8c0c8;
		--pin-rim: #8f9ba7;
		--pin-dark: #5c6875;
		--pin-wire: #c5cdd5;
		position: absolute;
		z-index: 4;
		left: 50%;
		top: 8%;
		width: var(--pin-size);
		height: calc(var(--pin-size) * 1.25);
		transform: translateX(-50%);
		isolation: isolate;
		user-select: none;
	}
	.paper-pin[data-tone="champagne"] {
		--pin-light: #fff4dc;
		--pin-glow: #fff9e6d6;
		--pin-mid: #d0bea0;
		--pin-rim: #aa9270;
		--pin-dark: #78674f;
		--pin-wire: #d9c8a8;
	}
	.paper-pin, .paper-pin * { pointer-events: none; }
	.paper-pin > span { position: absolute; display: block; }

	/* The puncture and shallow indentation stay underneath the metal. */
	.paper-pin__imprint {
		z-index: 0;
		left: 58%;
		top: 78%;
		width: 54%;
		height: 24%;
		border-radius: 50%;
		transform: translate(-50%, -50%) rotate(-16deg);
		background: radial-gradient(ellipse at 48% 44%, #040913b3 0 8%, #09122170 18%, #111a2b21 40%, transparent 68%);
		box-shadow: inset 0 .65px 1px #04081138, inset 0 -.55px .7px #edf2ff24, 0 .65px .5px #d9e4f012;
	}
	.paper-pin__shaft {
		z-index: 1;
		left: 53%;
		top: 34%;
		width: 11%;
		height: 46%;
		transform: rotate(-20deg);
		transform-origin: 50% 100%;
		border-radius: 1px;
		clip-path: polygon(0 0, 100% 0, 100% 76%, 48% 100%, 0 76%);
		background: linear-gradient(90deg, var(--pin-dark), var(--pin-wire) 36%, var(--pin-light) 52%, var(--pin-rim) 80%, var(--pin-dark));
	}
	.paper-pin__head {
		z-index: 2;
		left: 0;
		top: 0;
		width: 80%;
		aspect-ratio: 1;
		border-radius: 50%;
		background:
			radial-gradient(ellipse at 29% 20%, var(--pin-light) 0 3%, transparent 20%),
			radial-gradient(ellipse at 34% 25%, var(--pin-glow), transparent 48%),
			linear-gradient(139deg, var(--pin-light), var(--pin-mid) 30%, var(--pin-rim) 47%, var(--pin-light) 60%, var(--pin-mid) 72%, var(--pin-dark));
		box-shadow:
			inset .55px .65px .65px #ffffff96,
			inset -.65px -.85px 1.15px #17202f6b,
			0 .7px .7px #02071152,
			1.4px 3px 3.3px -1.1px #02071173;
	}
	.paper-pin__head::before {
		content: '';
		position: absolute;
		inset: 1px;
		border: .5px solid #ffffff40;
		border-right-color: #27334324;
		border-bottom-color: #27334338;
		border-radius: inherit;
	}
	.paper-pin__head::after {
		content: '';
		position: absolute;
		left: 24%;
		top: 16%;
		width: 35%;
		height: 1px;
		border-radius: 50%;
		transform: rotate(-32deg);
		background: linear-gradient(90deg, transparent, var(--pin-light), transparent);
		opacity: .7;
	}
</style>
